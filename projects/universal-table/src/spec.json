  "steps": [
    "Drag one or more fields into Columns.",
    "Add measures to Values to unlock totals, data bars and Pivot.",
    "Optionally add a Group by field for collapsible groups.",
    "Click a column header to sort; use Settings to filter, colour and add columns."
  ],
  "faq": [
    {
      "q": "How many rows can it show?",
      "a": "Power BI delivers up to 30,000 rows; the table shows them page by page for speed."
    },
    {
      "q": "How does Pivot work?",
      "a": "Click Pivot, then pick Row groups, Column labels, a Value field and an Aggregation. Totals are in Settings > Data display."
    },
    {
      "q": "Can I add my own columns?",
      "a": "Yes. Settings > Analysis lets you add calculated columns (formulas) and combined columns (templates)."
    },
    {
      "q": "Does clicking a row filter other visuals?",
      "a": "Yes. Click selects the row; Ctrl-click selects several."
    }
  ],
