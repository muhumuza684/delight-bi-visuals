{
  "dataRoles": [
    {
      "name": "rows",
      "displayName": "Columns",
      "kind": "Grouping",
      "description": "The fields shown as columns. Add as many as you need."
    },
    {
      "name": "groupBy",
      "displayName": "Group by",
      "kind": "Grouping",
      "description": "Optional field to group rows with collapsible subtotals."
    },
    {
      "name": "values",
      "displayName": "Values",
      "kind": "Measure",
      "description": "Measures shown as numeric columns with totals."
    },
    {
      "name": "tooltips",
      "displayName": "Tooltips",
      "kind": "GroupingOrMeasure",
      "description": "Extra fields shown in the Power BI tooltip."
    }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "rows"
              }
            },
            {
              "for": {
                "in": "groupBy"
              }
            },
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
  "objects": {
    "theme": {
      "displayName": "Theme",
      "properties": {
        "preset": {
          "displayName": "Visual theme",
          "type": {
            "enumeration": [
              {
                "value": "luxe",
                "displayName": "Default"
              },
              {
                "value": "slate",
                "displayName": "Slate"
              },
              {
                "value": "ocean",
                "displayName": "Ocean"
              },
              {
                "value": "forest",
                "displayName": "Forest"
              },
              {
                "value": "sunrise",
                "displayName": "Sunrise"
              },
              {
                "value": "midnight",
                "displayName": "Midnight"
              },
              {
                "value": "classic",
                "displayName": "Classic"
              }
            ]
          }
        },
        "accent": {
          "displayName": "Accent colour",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "density": {
          "displayName": "Density",
          "type": {
            "enumeration": [
              {
                "value": "comfortable",
                "displayName": "Comfortable"
              },
              {
                "value": "compact",
                "displayName": "Compact"
              }
            ]
          }
        }
      }
    },
    "general": {
      "displayName": "General",
      "properties": {
        "fontSize": {
          "displayName": "Text size",
          "type": {
            "numeric": true
          }
        },
        "rowHeight": {
          "displayName": "Row height",
          "type": {
            "numeric": true
          }
        },
        "showHeader": {
          "displayName": "Show header",
          "type": {
            "bool": true
          }
        },
        "showWelcome": {
          "displayName": "Show welcome card",
          "type": {
            "bool": true
          }
        }
      }
    },
    "views": {
      "displayName": "Saved layouts",
      "properties": {
        "layouts": {
          "displayName": "Saved layouts",
          "type": {
            "text": true
          }
        }
      }
    },
    "table": {
      "displayName": "Table",
      "properties": {
        "striped": {
          "displayName": "Striped rows",
          "type": {
            "bool": true
          }
        },
        "showTotals": {
          "displayName": "Show totals",
          "type": {
            "bool": true
          }
        },
        "dataBars": {
          "displayName": "Data bars on first measure",
          "type": {
            "bool": true
          }
        },
        "pageSize": {
          "displayName": "Rows per page",
          "type": {
            "numeric": true
          }
        },
        "showSearch": {
          "displayName": "Show search box",
          "type": {
            "bool": true
          }
        },
        "accentFirstColumn": {
          "displayName": "Accent first column",
          "type": {
            "bool": true
          }
        },
        "emphasizeHeaders": {
          "displayName": "Emphasize headers",
          "type": {
            "bool": true
          }
        },
        "pivotEnabled": {
          "displayName": "Show Pivot button",
          "type": {
            "bool": true
          }
        },
        "pivotRowTotals": {
          "displayName": "Pivot row totals",
          "type": {
            "bool": true
          }
        },
        "pivotColumnTotals": {
          "displayName": "Pivot column totals",
          "type": {
            "bool": true
          }
        },
        "pivotGrandTotal": {
          "displayName": "Pivot grand total",
          "type": {
            "bool": true
          }
        },
        "pivotEmpty": {
          "displayName": "Pivot empty cells",
          "type": {
            "enumeration": [
              {
                "value": "blank",
                "displayName": "Blank"
              },
              {
                "value": "dash",
                "displayName": "Dash"
              },
              {
                "value": "zero",
                "displayName": "Zero"
              }
            ]
          }
        }
      }
    },
    "tablestate": {
      "displayName": "Table state",
      "properties": {
        "state": {
          "displayName": "State",
          "type": {
            "text": true
          }
        }
      }
    }
  },
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "tooltips"
    ]
  },
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "suppressDefaultTitle": true,
  "privileges": [
    {
      "name": "ExportContent",
      "essential": false
    }
  ]
}
