{
  "dataRoles": [
    {
      "name": "category",
      "displayName": "Category",
      "kind": "Grouping",
      "description": "The axis categories (for example month or region)."
    },
    {
      "name": "series",
      "displayName": "Series",
      "kind": "Grouping",
      "description": "Optional legend field that splits each category."
    },
    {
      "name": "values",
      "displayName": "Values",
      "kind": "Measure",
      "description": "One or more measures to plot."
    },
    {
      "name": "tooltips",
      "displayName": "Tooltips",
      "kind": "GroupingOrMeasure",
      "description": "Extra fields shown in the Power BI tooltip."
    }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "series"
              }
            },
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
  "objects": {
    "theme": {
      "displayName": "Theme",
      "properties": {
        "preset": {
          "displayName": "Visual theme",
          "type": {
            "enumeration": [
              {
                "value": "luxe",
                "displayName": "Default"
              },
              {
                "value": "slate",
                "displayName": "Slate"
              },
              {
                "value": "ocean",
                "displayName": "Ocean"
              },
              {
                "value": "forest",
                "displayName": "Forest"
              },
              {
                "value": "sunrise",
                "displayName": "Sunrise"
              },
              {
                "value": "midnight",
                "displayName": "Midnight"
              },
              {
                "value": "classic",
                "displayName": "Classic"
              }
            ]
          }
        },
        "accent": {
          "displayName": "Accent colour",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "density": {
          "displayName": "Density",
          "type": {
            "enumeration": [
              {
                "value": "comfortable",
                "displayName": "Comfortable"
              },
              {
                "value": "compact",
                "displayName": "Compact"
              }
            ]
          }
        }
      }
    },
    "general": {
      "displayName": "General",
      "properties": {
        "fontSize": {
          "displayName": "Text size",
          "type": {
            "numeric": true
          }
        },
        "rowHeight": {
          "displayName": "Row height",
          "type": {
            "numeric": true
          }
        },
        "showHeader": {
          "displayName": "Show header",
          "type": {
            "bool": true
          }
        },
        "showWelcome": {
          "displayName": "Show welcome card",
          "type": {
            "bool": true
          }
        }
      }
    },
    "views": {
      "displayName": "Saved layouts",
      "properties": {
        "layouts": {
          "displayName": "Saved layouts",
          "type": {
            "text": true
          }
        }
      }
    },
    "chart": {
      "displayName": "Chart",
      "properties": {
        "type": {
          "displayName": "Chart type",
          "type": {
            "enumeration": [
              {
                "value": "bar",
                "displayName": "Clustered bars"
              },
              {
                "value": "stacked",
                "displayName": "Stacked bars"
              },
              {
                "value": "line",
                "displayName": "Line"
              },
              {
                "value": "area",
                "displayName": "Area"
              }
            ]
          }
        },
        "sort": {
          "displayName": "Sort categories",
          "type": {
            "enumeration": [
              {
                "value": "none",
                "displayName": "Data order"
              },
              {
                "value": "desc",
                "displayName": "Highest first"
              },
              {
                "value": "asc",
                "displayName": "Lowest first"
              }
            ]
          }
        },
        "maxCategories": {
          "displayName": "Top categories (0 = all)",
          "type": {
            "numeric": true
          }
        },
        "showLabels": {
          "displayName": "Value labels",
          "type": {
            "bool": true
          }
        },
        "showAverage": {
          "displayName": "Average line",
          "type": {
            "bool": true
          }
        },
        "showGrid": {
          "displayName": "Show grid lines",
          "type": {
            "bool": true
          }
        },
        "showLegend": {
          "displayName": "Show legend",
          "type": {
            "bool": true
          }
        }
      }
    }
  },
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "tooltips"
    ]
  },
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "suppressDefaultTitle": true,
  "privileges": [
    {
      "name": "ExportContent",
      "essential": false
    }
  ]
}
