{
  "dataRoles": [
    {
      "name": "task",
      "displayName": "Task",
      "kind": "Grouping",
      "description": "The task or work item name."
    },
    {
      "name": "due",
      "displayName": "Due date",
      "kind": "Grouping",
      "description": "Task end or due date."
    },
    {
      "name": "start",
      "displayName": "Start date",
      "kind": "Grouping",
      "description": "Task start date. Without it, tasks show as milestones."
    },
    {
      "name": "owner",
      "displayName": "Owner",
      "kind": "Grouping",
      "description": "Person or team responsible."
    },
    {
      "name": "status",
      "displayName": "Status",
      "kind": "Grouping",
      "description": "For example Not started, In progress, Done."
    },
    {
      "name": "progress",
      "displayName": "Progress",
      "kind": "Measure",
      "description": "0 to 1 (or 0 to 100) percent complete."
    },
    {
      "name": "group",
      "displayName": "Group",
      "kind": "Grouping",
      "description": "Phase or workstream to group tasks under."
    },
    {
      "name": "tooltips",
      "displayName": "Tooltips",
      "kind": "GroupingOrMeasure",
      "description": "Extra fields shown in the Power BI tooltip."
    }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "task"
              }
            },
            {
              "for": {
                "in": "due"
              }
            },
            {
              "for": {
                "in": "start"
              }
            },
            {
              "for": {
                "in": "owner"
              }
            },
            {
              "for": {
                "in": "status"
              }
            },
            {
              "for": {
                "in": "progress"
              }
            },
            {
              "for": {
                "in": "group"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
  "objects": {
    "theme": {
      "displayName": "Theme",
      "properties": {
        "preset": {
          "displayName": "Visual theme",
          "type": {
            "enumeration": [
              {
                "value": "luxe",
                "displayName": "Default"
              },
              {
                "value": "slate",
                "displayName": "Slate"
              },
              {
                "value": "ocean",
                "displayName": "Ocean"
              },
              {
                "value": "forest",
                "displayName": "Forest"
              },
              {
                "value": "sunrise",
                "displayName": "Sunrise"
              },
              {
                "value": "midnight",
                "displayName": "Midnight"
              },
              {
                "value": "classic",
                "displayName": "Classic"
              }
            ]
          }
        },
        "accent": {
          "displayName": "Accent colour",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "density": {
          "displayName": "Density",
          "type": {
            "enumeration": [
              {
                "value": "comfortable",
                "displayName": "Comfortable"
              },
              {
                "value": "compact",
                "displayName": "Compact"
              }
            ]
          }
        }
      }
    },
    "general": {
      "displayName": "General",
      "properties": {
        "fontSize": {
          "displayName": "Text size",
          "type": {
            "numeric": true
          }
        },
        "rowHeight": {
          "displayName": "Row height",
          "type": {
            "numeric": true
          }
        },
        "showHeader": {
          "displayName": "Show header",
          "type": {
            "bool": true
          }
        },
        "showWelcome": {
          "displayName": "Show welcome card",
          "type": {
            "bool": true
          }
        }
      }
    },
    "views": {
      "displayName": "Saved layouts",
      "properties": {
        "layouts": {
          "displayName": "Saved layouts",
          "type": {
            "text": true
          }
        }
      }
    },
    "planner": {
      "displayName": "Planner",
      "properties": {
        "view": {
          "displayName": "Default view",
          "type": {
            "enumeration": [
              {
                "value": "timeline",
                "displayName": "Timeline"
              },
              {
                "value": "list",
                "displayName": "List"
              }
            ]
          }
        },
        "colorBy": {
          "displayName": "Colour by",
          "type": {
            "enumeration": [
              {
                "value": "status",
                "displayName": "Status"
              },
              {
                "value": "owner",
                "displayName": "Owner"
              },
              {
                "value": "group",
                "displayName": "Group"
              }
            ]
          }
        },
        "showToday": {
          "displayName": "Show today line",
          "type": {
            "bool": true
          }
        },
        "showProgress": {
          "displayName": "Show progress fill",
          "type": {
            "bool": true
          }
        },
        "showSummary": {
          "displayName": "Show summary",
          "type": {
            "bool": true
          }
        },
        "showOwner": {
          "displayName": "Show owner",
          "type": {
            "bool": true
          }
        },
        "showOverdueFlag": {
          "displayName": "Flag overdue tasks",
          "type": {
            "bool": true
          }
        }
      }
    }
  },
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "tooltips"
    ]
  },
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "suppressDefaultTitle": true,
  "privileges": [
    {
      "name": "ExportContent",
      "essential": false
    }
  ]
}
