{
  "dataRoles": [
    {
      "name": "location",
      "displayName": "Location",
      "kind": "Grouping",
      "description": "A country name for a filled map (for example Uganda or Kenya), or the label for each point."
    },
    {
      "name": "latitude",
      "displayName": "Latitude",
      "kind": "GroupingOrMeasure",
      "description": "Latitude in decimal degrees. Use together with Longitude."
    },
    {
      "name": "longitude",
      "displayName": "Longitude",
      "kind": "GroupingOrMeasure",
      "description": "Longitude in decimal degrees. Use together with Latitude."
    },
    {
      "name": "value",
      "displayName": "Size / colour",
      "kind": "Measure",
      "description": "Measure that sets bubble size, or the depth of colour for a country."
    },
    {
      "name": "tooltips",
      "displayName": "Tooltips",
      "kind": "GroupingOrMeasure",
      "description": "Extra fields shown in the Power BI tooltip."
    }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "location"
              }
            },
            {
              "for": {
                "in": "latitude"
              }
            },
            {
              "for": {
                "in": "longitude"
              }
            },
            {
              "for": {
                "in": "value"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
  "objects": {
    "theme": {
      "displayName": "Theme",
      "properties": {
        "preset": {
          "displayName": "Visual theme",
          "type": {
            "enumeration": [
              {
                "value": "luxe",
                "displayName": "Default"
              },
              {
                "value": "slate",
                "displayName": "Slate"
              },
              {
                "value": "ocean",
                "displayName": "Ocean"
              },
              {
                "value": "forest",
                "displayName": "Forest"
              },
              {
                "value": "sunrise",
                "displayName": "Sunrise"
              },
              {
                "value": "midnight",
                "displayName": "Midnight"
              },
              {
                "value": "classic",
                "displayName": "Classic"
              }
            ]
          }
        },
        "accent": {
          "displayName": "Accent colour",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "density": {
          "displayName": "Density",
          "type": {
            "enumeration": [
              {
                "value": "comfortable",
                "displayName": "Comfortable"
              },
              {
                "value": "compact",
                "displayName": "Compact"
              }
            ]
          }
        }
      }
    },
    "general": {
      "displayName": "General",
      "properties": {
        "fontSize": {
          "displayName": "Text size",
          "type": {
            "numeric": true
          }
        },
        "rowHeight": {
          "displayName": "Row height",
          "type": {
            "numeric": true
          }
        },
        "showHeader": {
          "displayName": "Show header",
          "type": {
            "bool": true
          }
        },
        "showWelcome": {
          "displayName": "Show welcome card",
          "type": {
            "bool": true
          }
        }
      }
    },
    "views": {
      "displayName": "Saved layouts",
      "properties": {
        "layouts": {
          "displayName": "Saved layouts",
          "type": {
            "text": true
          }
        }
      }
    },
    "geo": {
      "displayName": "Map",
      "properties": {
        "maxRadius": {
          "displayName": "Largest bubble",
          "type": {
            "numeric": true
          }
        },
        "showLabels": {
          "displayName": "Show labels",
          "type": {
            "bool": true
          }
        },
        "showOutline": {
          "displayName": "Show country borders",
          "type": {
            "bool": true
          }
        },
        "bubbleOpacity": {
          "displayName": "Bubble opacity (%)",
          "type": {
            "numeric": true
          }
        },
        "showList": {
          "displayName": "Show ranked list",
          "type": {
            "bool": true
          }
        }
      }
    }
  },
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "tooltips"
    ]
  },
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "suppressDefaultTitle": true,
  "privileges": [
    {
      "name": "ExportContent",
      "essential": false
    }
  ]
}
