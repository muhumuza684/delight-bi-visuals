{
  "dataRoles": [
    {
      "name": "kpi",
      "displayName": "KPI name",
      "kind": "Grouping",
      "description": "Creates one card per value. Leave empty for a single overall card."
    },
    {
      "name": "actual",
      "displayName": "Actual",
      "kind": "Measure",
      "description": "The current value of the KPI."
    },
    {
      "name": "target",
      "displayName": "Target",
      "kind": "Measure",
      "description": "Goal to compare against; drives the status colour."
    },
    {
      "name": "previous",
      "displayName": "Previous period",
      "kind": "Measure",
      "description": "Shows change versus the previous period."
    },
    {
      "name": "period",
      "displayName": "Trend axis",
      "kind": "Grouping",
      "description": "Date or period used to draw the sparkline and pick the latest value."
    },
    {
      "name": "tooltips",
      "displayName": "Tooltips",
      "kind": "GroupingOrMeasure",
      "description": "Extra fields shown in the Power BI tooltip."
    }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "kpi"
              }
            },
            {
              "for": {
                "in": "actual"
              }
            },
            {
              "for": {
                "in": "target"
              }
            },
            {
              "for": {
                "in": "previous"
              }
            },
            {
              "for": {
                "in": "period"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
  "objects": {
    "theme": {
      "displayName": "Theme",
      "properties": {
        "preset": {
          "displayName": "Visual theme",
          "type": {
            "enumeration": [
              {
                "value": "luxe",
                "displayName": "Default"
              },
              {
                "value": "slate",
                "displayName": "Slate"
              },
              {
                "value": "ocean",
                "displayName": "Ocean"
              },
              {
                "value": "forest",
                "displayName": "Forest"
              },
              {
                "value": "sunrise",
                "displayName": "Sunrise"
              },
              {
                "value": "midnight",
                "displayName": "Midnight"
              },
              {
                "value": "classic",
                "displayName": "Classic"
              }
            ]
          }
        },
        "accent": {
          "displayName": "Accent colour",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "density": {
          "displayName": "Density",
          "type": {
            "enumeration": [
              {
                "value": "comfortable",
                "displayName": "Comfortable"
              },
              {
                "value": "compact",
                "displayName": "Compact"
              }
            ]
          }
        }
      }
    },
    "general": {
      "displayName": "General",
      "properties": {
        "fontSize": {
          "displayName": "Text size",
          "type": {
            "numeric": true
          }
        },
        "rowHeight": {
          "displayName": "Row height",
          "type": {
            "numeric": true
          }
        },
        "showHeader": {
          "displayName": "Show header",
          "type": {
            "bool": true
          }
        },
        "showWelcome": {
          "displayName": "Show welcome card",
          "type": {
            "bool": true
          }
        }
      }
    },
    "views": {
      "displayName": "Saved layouts",
      "properties": {
        "layouts": {
          "displayName": "Saved layouts",
          "type": {
            "text": true
          }
        }
      }
    },
    "kpi": {
      "displayName": "KPI",
      "properties": {
        "lowerIsBetter": {
          "displayName": "Lower is better",
          "type": {
            "bool": true
          }
        },
        "greenAt": {
          "displayName": "Green at (% of target)",
          "type": {
            "numeric": true
          }
        },
        "amberAt": {
          "displayName": "Amber at (% of target)",
          "type": {
            "numeric": true
          }
        },
        "showSparkline": {
          "displayName": "Show sparkline",
          "type": {
            "bool": true
          }
        },
        "showTargetBar": {
          "displayName": "Show target bar",
          "type": {
            "bool": true
          }
        },
        "showDelta": {
          "displayName": "Show change vs previous",
          "type": {
            "bool": true
          }
        },
        "cardMinWidth": {
          "displayName": "Card width",
          "type": {
            "numeric": true
          }
        }
      }
    }
  },
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "tooltips"
    ]
  },
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "suppressDefaultTitle": true,
  "privileges": [
    {
      "name": "ExportContent",
      "essential": false
    }
  ]
}
